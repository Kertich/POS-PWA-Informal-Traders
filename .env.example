# SQLite file relative to the process working directory
DATABASE_URL=sqlite:///./poshawker.db

# JWT — generate a long random value before running in any shared environment
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated PWA origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Safaricom Daraja (sandbox first). Leave blank until M-PESA is wired.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
